DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a random value for stable browser sessions; an ephemeral key is used if absent.
SECRET_KEY=
# Optional classroom clerk key. Blank enables local demo schedule editing.
CLERK_KEY=
# Clerk CLI development keys are pulled into the separate ignored .env.clerk file.
# Only the publishable key reaches the browser. Never expose CLERK_SECRET_KEY.
CLERK_AUTHORIZED_PARTIES=http://localhost:5000,http://127.0.0.1:5000
